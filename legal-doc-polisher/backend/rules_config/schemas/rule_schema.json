{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Legal Document Polisher Rules Configuration",
  "type": "object",
  "required": ["version", "rules"],
  "properties": {
    "version": { "type": "integer" },
    "rules": {
      "type": "object",
      "properties": {
        "heading_style": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "majority_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "properties_to_check": { "type": "array", "items": { "type": "string" } },
            "skip_levels": { "type": "array", "items": { "type": "integer" } }
          }
        },
        "quote_style": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "target": { "type": "string", "enum": ["smart", "straight"] }
          }
        },
        "list_labels": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "check_sequence": { "type": "boolean" },
            "check_format_consistency": { "type": "boolean" },
            "check_nesting": { "type": "boolean" }
          }
        },
        "paragraph_format": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "majority_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "properties_to_check": { "type": "array", "items": { "type": "string" } },
            "tolerance": { "type": "object" }
          }
        },
        "cross_references": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } }
        },
        "definition_format": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } }
        },
        "signature_block": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } }
        },
        "header_footer": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    }
  }
}
